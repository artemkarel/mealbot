# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# Токен бота от @BotFather
BOT_TOKEN=ВСТАВЬ_ТОКЕН

# Кому разрешён доступ: Telegram ID через запятую (узнать: команда /myid в боте).
# Пусто = доступ всем, кто найдёт бота. Заполни ID семьи для приватности.
ALLOWED_IDS=

# Кто может обновлять и перезапускать бота (/update, /restart).
# Если пусто — берётся ALLOWED_IDS. Впиши сюда свой ID.
ADMIN_IDS=

# Часовой пояс для напоминаний
TZ=Europe/Samara

# Адрес Mini App (если поднял веб-приложение). Пусто — бот работает без него.
WEBAPP_URL=https://zdorovaedabot.duckdns.org
