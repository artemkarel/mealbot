BOT_TOKEN=сюда_токен_от_BotFather
WEBAPP_URL=https://твой-домен/
# пусто = бот открыт всем, у каждого пользователя свои планы и настройки;
# впиши ID через запятую, если хочешь закрытый режим
ALLOWED_USER_IDS=
# кому доступны /update, /restart и /version
ADMIN_USER_IDS=твой_telegram_id
DB_PATH=data/mealplan.db
# напоминания каждый пользователь настраивает сам в приложении (Профиль);
# TZ задаёт часовой пояс, по которому они срабатывают
TZ=Europe/Samara
# распознавание планов из файла/фото при добавлении: ключ с console.anthropic.com;
# пусто = добавлять план можно только через бота файлом .docx/.txt
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# бот в мессенджере MAX: токен от МастерБота (dev.max.ru); пусто = MAX выключен
MAX_BOT_TOKEN=
# MAX_API_BASE=https://platform-api2.max.ru
